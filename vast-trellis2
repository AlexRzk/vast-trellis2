#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${VAST_TRELLIS_LIB_DIR:-/usr/local/lib/vast-trellis2}"

# Run directly from the repository or from /usr/local/bin after install.sh.
if [[ -f "$SCRIPT_DIR/lib/common.sh" ]]; then
  TOOL_ROOT="$SCRIPT_DIR"
else
  TOOL_ROOT="$LIB_DIR"
fi

for f in common.sh install.sh download.sh runtime.sh lifecycle.sh; do
  [[ -f "$TOOL_ROOT/lib/$f" ]] || { echo "ERROR: missing $TOOL_ROOT/lib/$f. Re-run install.sh." >&2; exit 1; }
done

# shellcheck disable=SC1091
source "$TOOL_ROOT/lib/common.sh"
# shellcheck disable=SC1091
source "$TOOL_ROOT/lib/install.sh"
# download.sh intentionally overrides cmd_download from install.sh.
# shellcheck disable=SC1091
source "$TOOL_ROOT/lib/download.sh"
# shellcheck disable=SC1091
source "$TOOL_ROOT/lib/runtime.sh"
# Loaded last so robust process discovery overrides the basic PID-file-only lifecycle.
# shellcheck disable=SC1091
source "$TOOL_ROOT/lib/lifecycle.sh"

# Direct repository execution uses the long source filename; installed layout uses
# /usr/local/lib/vast-trellis2/vast-trellis-doctor.
[[ -x "$TOOL_ROOT/vast-trellis2-doctor" ]] && DOCTOR_TOOL="$TOOL_ROOT/vast-trellis2-doctor"

load_config
case "${1:-}" in
  ""|menu) show_splash; main_menu ;;
  wizard) shift; cmd_wizard "$@" ;;
  detect) shift; cmd_detect "$@" ;;
  install) shift; cmd_install "$@" ;;
  auth|login) shift; cmd_auth "$@" ;;
  download) shift; cmd_download "$@" ;;
  hf-speedtest) shift; cmd_hf_speedtest "$@" ;;
  dino-local) shift; cmd_dino_local "$@" ;;
  run) shift; run_foreground "$@" ;;
  start|launch) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  restart) shift; cmd_stop; cmd_start ;;
  status) shift; cmd_status "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  explain) shift; cmd_explain "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  repair) shift; cmd_doctor --fix "$@" ;;
  reset-build) shift; cmd_reset_build "$@" ;;
  tunnel) shift; cmd_tunnel "$@" ;;
  config|show) shift; cmd_config "$@" ;;
  help|-h|--help) usage ;;
  *) usage; die "Unknown command: $1" ;;
esac
